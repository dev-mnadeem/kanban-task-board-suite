# Copy to .env and adjust. .env is gitignored.

# --- Django ---
# Required when DJANGO_DEBUG is off. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated origins allowed to call the GraphQL endpoint.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- DynamoDB ---
# Point at DynamoDB Local (docker compose) or any AWS-compatible endpoint.
# Leave DYNAMODB_ENDPOINT_URL empty to use real AWS DynamoDB.
DYNAMODB_ENDPOINT_URL=http://localhost:8000
DYNAMODB_CARD_TABLE=Card
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
